rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 研究室のデータは labs/{labId} 以下にまとめて置く。
    // ログイン画面は無く、各端末が自動で匿名サインインする(=URLを知っていれば誰でも読み書き可)。
    match /labs/{lab} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
